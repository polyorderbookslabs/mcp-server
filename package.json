{
  "name": "@polyorderbooks/mcp-server",
  "version": "0.2.3",
  "description": "MCP server for historical Polymarket order books, prices and liquidity \u2014 1-second L2 depth on resolved prediction markets.",
  "type": "module",
  "bin": {
    "polyorderbooks-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "polymarket",
    "prediction-markets",
    "order-book",
    "market-data",
    "historical-data",
    "claude",
    "llm",
    "trading"
  ],
  "author": "PolyOrderbooks",
  "license": "MIT",
  "homepage": "https://polyorderbooks.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyorderbookslabs/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/polyorderbookslabs/mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
